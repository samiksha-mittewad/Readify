<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= book.title %> | Readify</title>


    <!-- Google Fonts -->

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
        rel="stylesheet"
    >


    <!-- Font Awesome -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <!-- Main CSS -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >


    <style>

        /* =========================================
           DETAILS PAGE
        ========================================= */

        .details-page {

            min-height: 100vh;

            background: #f7f4ed;

            padding: 80px 7%;

        }


        .details-container {

            max-width: 1150px;

            margin: 0 auto;

        }


        /* =========================================
           BACK BUTTON
        ========================================= */

        .back-link {

            display: inline-flex;

            align-items: center;

            gap: 8px;

            margin-bottom: 35px;

            color: #174c3c;

            text-decoration: none;

            font-family: "Space Grotesk", sans-serif;

            font-size: 13px;

            font-weight: 700;

            transition: 0.25s ease;

        }


        .back-link:hover {

            color: #c59a5a;

            transform: translateX(-4px);

        }


        /* =========================================
           MAIN CARD
        ========================================= */

        .book-details-card {

            display: grid;

            grid-template-columns: 0.8fr 1.2fr;

            gap: 70px;

            background: #fffdf8;

            padding: 55px;

            border-radius: 28px;

            border: 1px solid
                rgba(23, 76, 60, 0.08);

            box-shadow:
                0 25px 70px
                rgba(23, 32, 29, 0.08);

        }


        /* =========================================
           IMAGE
        ========================================= */

        .details-image-wrapper {

            display: flex;

            align-items: center;

            justify-content: center;

        }


        .details-image {

            width: 100%;

            max-width: 350px;

            height: 500px;

            object-fit: cover;

            border-radius: 12px;

            box-shadow:
                0 25px 50px
                rgba(23, 32, 29, 0.18);

            transition: 0.35s ease;

        }


        .details-image:hover {

            transform:
                translateY(-8px)
                rotate(-1deg);

            box-shadow:
                0 35px 65px
                rgba(23, 32, 29, 0.22);

        }


        /* =========================================
           CONTENT
        ========================================= */

        .details-content {

            display: flex;

            flex-direction: column;

            justify-content: center;

        }


        /* =========================================
           CATEGORY
        ========================================= */

        .details-category {

            display: inline-block;

            width: fit-content;

            padding: 7px 13px;

            margin-bottom: 18px;

            border-radius: 20px;

            background:
                rgba(197, 154, 90, 0.14);

            color: #9a7036;

            font-family: "Space Grotesk", sans-serif;

            font-size: 10px;

            font-weight: 700;

            letter-spacing: 1.5px;

            text-transform: uppercase;

        }


        /* =========================================
           TITLE
        ========================================= */

        .details-title {

            margin: 0 0 8px;

            color: #17201d;

            font-family:
                "Cormorant Garamond",
                Georgia,
                serif;

            font-size:
                clamp(42px, 5vw, 65px);

            line-height: 0.95;

            font-weight: 700;

        }


        /* =========================================
           AUTHOR
        ========================================= */

        .details-author {

            margin-bottom: 25px;

            color: #77747c;

            font-family:
                "DM Sans",
                sans-serif;

            font-size: 16px;

        }


        .details-author strong {

            color: #174c3c;

        }


        /* =========================================
           DESCRIPTION
        ========================================= */

        .details-description {

            max-width: 650px;

            margin-bottom: 30px;

            color: #555a56;

            font-family:
                "DM Sans",
                sans-serif;

            font-size: 15px;

            line-height: 1.8;

        }


        /* =========================================
           PRICE
        ========================================= */

        .details-price {

            margin-bottom: 25px;

            color: #174c3c;

            font-family:
                "Space Grotesk",
                sans-serif;

            font-size: 30px;

            font-weight: 700;

        }


        /* =========================================
           META INFORMATION
        ========================================= */

        .details-meta {

            display: flex;

            flex-wrap: wrap;

            gap: 20px;

            margin-bottom: 30px;

            padding: 20px 0;

            border-top:
                1px solid #e7e2d8;

            border-bottom:
                1px solid #e7e2d8;

        }


        .meta-item {

            display: flex;

            align-items: center;

            gap: 9px;

            color: #555a56;

            font-family:
                "DM Sans",
                sans-serif;

            font-size: 13px;

        }


        .meta-item i {

            color: #c59a5a;

        }


        /* =========================================
           ADD TO CART BUTTON
        ========================================= */

        .details-cart-btn {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 10px;

            width: 100%;

            min-height: 55px;

            padding: 15px 25px;

            border: none;

            border-radius: 30px;

            background: #174c3c;

            color: #fffdf8;

            cursor: pointer;

            font-family:
                "Space Grotesk",
                sans-serif;

            font-size: 13px;

            font-weight: 700;

            letter-spacing: 0.5px;

            box-shadow:
                0 10px 25px
                rgba(23, 76, 60, 0.18);

            transition:
                transform 0.25s ease,
                background 0.25s ease,
                color 0.25s ease,
                box-shadow 0.25s ease;

        }


        .details-cart-btn:hover {

            background: #c59a5a;

            color: #17201d;

            transform: translateY(-3px);

            box-shadow:
                0 15px 30px
                rgba(23, 32, 29, 0.15);

        }


        .details-cart-btn:active {

            transform: translateY(0);

        }


        /* =========================================
           ADDED STATE
        ========================================= */

        .details-cart-btn.cart-added {

            background: #c59a5a;

            color: #17201d;

        }


        .details-cart-btn:disabled {

            cursor: wait;

            opacity: 0.9;

        }


        /* =========================================
           RESPONSIVE
        ========================================= */

        @media (max-width: 800px) {

            .details-page {

                padding: 50px 5%;

            }


            .book-details-card {

                grid-template-columns: 1fr;

                gap: 40px;

                padding: 30px;

            }


            .details-image {

                max-width: 280px;

                height: 400px;

            }


            .details-title {

                font-size: 48px;

            }

        }


        @media (max-width: 500px) {

            .book-details-card {

                padding: 22px;

            }


            .details-image {

                max-width: 230px;

                height: 340px;

            }


            .details-title {

                font-size: 40px;

            }


            .details-meta {

                flex-direction: column;

                gap: 12px;

            }

        }

    </style>

</head>


<body>


    <!-- =========================================
         NAVBAR
    ========================================= -->

    <%- include("../partials/navbar") %>


    <!-- =========================================
         BOOK DETAILS
    ========================================= -->

    <main class="details-page">

        <div class="details-container">


            <!-- BACK -->

            <a
                href="/books"
                class="back-link"
            >

                <i class="fa-solid fa-arrow-left"></i>

                Back to Books

            </a>


            <!-- BOOK CARD -->

            <section class="book-details-card">


                <!-- =================================
                     BOOK IMAGE
                ================================= -->

                <div class="details-image-wrapper">

                    <% if (book.image) { %>

                        <img
                            src="<%= book.image %>"
                            alt="<%= book.title %>"
                            class="details-image"
                        >

                    <% } else { %>

                        <div
                            class="details-image"
                            style="
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                background:#e8e3d8;
                                color:#174c3c;
                                font-size:80px;
                            "
                        >

                            <i
                                class="fa-solid fa-book-open"
                            ></i>

                        </div>

                    <% } %>

                </div>


                <!-- =================================
                     BOOK INFORMATION
                ================================= -->

                <div class="details-content">


                    <!-- CATEGORY -->

                    <% if (book.category) { %>

                        <span
                            class="details-category"
                        >

                            <%= book.category %>

                        </span>

                    <% } %>


                    <!-- TITLE -->

                    <h1 class="details-title">

                        <%= book.title %>

                    </h1>


                    <!-- AUTHOR -->

                    <div class="details-author">

                        Written by

                        <strong>

                            <%= book.author %>

                        </strong>

                    </div>


                    <!-- DESCRIPTION -->

                    <p class="details-description">

                        <%= book.description ||
                        "Discover this fascinating book and add it to your personal collection." %>

                    </p>


                    <!-- PRICE -->

                    <div class="details-price">

                        ₹<%= Number(book.price).toFixed(2) %>

                    </div>


                    <!-- META -->

                    <div class="details-meta">


                        <div class="meta-item">

                            <i
                                class="fa-solid fa-book"
                            ></i>

                            <span>
                                Available
                            </span>

                        </div>


                        <div class="meta-item">

                            <i
                                class="fa-solid fa-tag"
                            ></i>

                            <span>

                                <%= book.category ||
                                "General" %>

                            </span>

                        </div>


                        <div class="meta-item">

                            <i
                                class="fa-solid fa-feather-pointed"
                            ></i>

                            <span>
                                Readify Collection
                            </span>

                        </div>


                    </div>


                    <!-- =================================
                         ADD TO CART
                    ================================= -->

                    <button
                        type="button"
                        class="details-cart-btn"
                        data-book-id="<%= book.id %>"
                    >

                        <i
                            class="fa-solid fa-cart-shopping"
                        ></i>

                        Add to Cart

                    </button>


                </div>

            </section>

        </div>

    </main>


    <!-- =========================================
         FOOTER
    ========================================= -->

    <%- include("../partials/footer") %>


    <!-- =========================================
         CART JAVASCRIPT
    ========================================= -->

    <script src="/js/cart.js"></script>


</body>

</html>