                    </a>

                <% } %>


                <a href="/books">
                    Browse Collection
                </a>


            </div>



            <div class="footer-links">


                <h4>
                    Readify
                </h4>


                <p class="footer-note">
                    Stories that stay with you.
                </p>


                <span class="footer-contact">

                    <i class="fa-solid fa-envelope"></i>

                    support@readify.com

                </span>


                <span class="footer-contact">

                    <i class="fa-solid fa-location-dot"></i>

